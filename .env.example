# Environment Variables — ProcInvoice

# PostgreSQL Database (Supabase or Neon recommended)
DATABASE_URL="postgresql://user:password@host:5432/procinvoice?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3005"

# Google Cloud Vision API (for OCR)
# GOOGLE_CLOUD_VISION_KEY="your-google-cloud-api-key"
# OR use AWS Textract
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# File Storage (Supabase Storage or S3)
STORAGE_BUCKET_URL="https://your-project.supabase.co/storage/v1"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_BUCKET_NAME="invoices"

# Field-Level Encryption Key (32 bytes hex — for encrypting VAT/IBAN)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="your-32-byte-hex-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"
