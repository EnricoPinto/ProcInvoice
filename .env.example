# ==============================================================================
# ProcInvoice - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler URL (recommended for serverless/Vercel, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection (port 5432) used for Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth v5)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-byte-base64-secret"

# Local development URL (auto-handled on Vercel, but required locally)
NEXTAUTH_URL="http://localhost:3005"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Field-Level Data Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hex key (64 characters) used for encrypting VAT, IBAN, and personal data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="your-64-character-hex-encryption-key"
KEY_VERSION="v1"

# ------------------------------------------------------------------------------
# 4. OCR & AI Structured Extraction
# ------------------------------------------------------------------------------
# Gemini API Key (Free tier via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# (Optional fallback) Google Cloud Vision API Key
# GOOGLE_VISION_API_KEY="your-google-cloud-vision-api-key"

# ------------------------------------------------------------------------------
# 5. File Storage (Optional - Invoices are stored in DB by default)
# ------------------------------------------------------------------------------
# If using Supabase Storage or S3 for external PDF file hosting:
# STORAGE_BUCKET_URL="https://[PROJECT_REF].supabase.co/storage/v1"
# STORAGE_ACCESS_KEY="your-supabase-service-role-key"
# STORAGE_BUCKET_NAME="invoices"

# ------------------------------------------------------------------------------
# 6. Application & Support Branding
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3005"
SUPPORT_ADMIN_EMAIL="support@procinvoice.example"
NEXT_PUBLIC_SUPPORT_EMAIL="support@procinvoice.example"
